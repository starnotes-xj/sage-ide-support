<idea-plugin>
  <id>com.starnotesxj.sageide</id>
  <name>Sage IDE Support</name>
  <vendor email="starnotes@qq.com" url="https://github.com/starnotes-xj/sage-ide-support">starnotes-xj</vendor>
  <version>1.5.0</version>

  <change-notes><![CDATA[
  <ul>
    <li>1.5.0 — Sage postfix completion: .ZZ/.QQ/.RR/.CC/.SR/.Integer/.N/.factor/.show/.vector/.matrix,
        plus CTF number theory (.euler_phi, .carmichael_lambda, .divisors, .number_of_divisors,
        .prime_factors, .squarefree_part, .next_prime, .random_prime, .primitive_root, .factorial,
        .numerator, .denominator, .continued_fraction, .cyclotomic_polynomial, .sage_eval) and
        bytes/int conversion (.b2i, .i2b); Python's built-in postfix set stays available.
        New inspection: flags ^ / ^= in unambiguous bytes contexts (Sage power vs Python XOR)
        with a quick fix to ^^.</li>
    <li>1.4.1 — Fix PsiInvalidElementAccessException on PyCharm 2026.2: stale stub-index
        elements are re-validated and never dereferenced through a dropped AST node.</li>
    <li>1.4.0 — Supports the whole PyCharm 2026 release year (261–263); GitHub Actions CI
        builds the plugin and attaches tagged releases.</li>
    <li>1.3.2 — The project tree shows the Sage icon for .sage files (file PSI override).</li>
  </ul>
  ]]></change-notes>

  <description><![CDATA[
  First-class Sage file support in PyCharm: <code>.sage</code> files are recognized
  as their own "Sage" file type (Python language intelligence underneath) with full
  Sage preparse-sugar semantics.
  <ul>
    <li>Registers a dedicated <code>Sage</code> file type for <code>*.sage</code> with all
        Python indexing, inspections and completion.</li>
    <li>Types Sage generator statements (<code>F.&lt;a&gt; = GF(2^8, ...)</code>,
        <code>R.&lt;x&gt; = GF(2)[]</code>): <code>F</code> receives the constructor's stub return
        type, <code>a</code>/<code>x</code> receive the element type from
        <code>_first_ngens</code>.</li>
    <li>Resolves generator references inside sugar statements (e.g. <code>x</code> in
        <code>modulus=x^8 + ...</code> navigates to its declaration).</li>
    <li>Suppresses parser-error squiggles on sugar statements only, keeping genuine errors red.</li>
  </ul>
  Requires the Python Community Edition plugin and the Sage type stubs installed by
  <code>sage-pycharm-stubgen --install</code> in the WSL Sage environment (configured as the project SDK).
  If <code>.sage</code> was manually associated with another type in Settings | Editor | File Types,
  remove that association so this plugin's Sage file type applies.
  ]]></description>

  <depends>com.intellij.modules.python</depends>

  <idea-version since-build="261" until-build="263.*"/>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Dedicated Sage file type with its own dialect language: the Sage parser
         understands generator sugar statements, everything else is Python. -->
    <fileType name="Sage"
              language="Sage"
              extensions="sage"
              implementationClass="com.starnotesxj.sageide.sugar.SageFileType"
              fieldName="INSTANCE"/>

    <!-- The Sage dialect parser: a Python parser extended with generator sugar. -->
    <lang.parserDefinition language="Sage"
                           implementationClass="com.starnotesxj.sageide.parser.SageParserDefinition"/>

    <!-- Defensive: if a sugar statement ever falls back to the error-recovered
         Python tree, suppress the parser-error squiggles on exactly that statement. -->
    <highlightErrorFilter implementation="com.starnotesxj.sageide.highlight.SageSugarErrorFilter"/>

    <!-- The one silently-breaking Sage/Python difference: in .sage, ^ is
         exponentiation, so Python XOR must be written ^^.  Flag ^ / ^= only
         in unambiguous bytes contexts (bytes literal/call, bytes-annotated
         names, or feeding bytes(...)); sage power math is never flagged. -->
    <localInspection language="Sage"
                     groupName="SageMath"
                     displayName="Misused ^ operator (Sage power vs Python XOR)"
                     enabledByDefault="true"
                     level="ERROR"
                     implementationClass="com.starnotesxj.sageide.highlight.SageXorInspection"/>

    <!-- Project view icon: the tree resolves file icons through the
         fileIconProvider chain, where a Python presentation can win for
         Python-dialect files (Sage is a dialect of Python).  Answer first
         with the Sage icon for .sage files; other files are untouched. -->
    <fileIconProvider implementation="com.starnotesxj.sageide.sugar.SageFileIconProvider" order="first"/>
    <iconProvider implementation="com.starnotesxj.sageide.sugar.SageElementIconProvider" order="first"/>

    <!-- Sage run configurations: execute through the `sage` command (native or WSL),
         with a gutter run icon, instead of a Python interpreter. -->
    <configurationType implementation="com.starnotesxj.sageide.run.SageRunConfigurationType"/>
    <runConfigurationProducer implementation="com.starnotesxj.sageide.run.SageRunConfigurationProducer"/>
    <runLineMarkerContributor language="Sage"
                              implementationClass="com.starnotesxj.sageide.run.SageRunLineMarkerContributor"/>

    <!-- Shared Sage execution settings (Settings | Tools | SageMath). -->
    <applicationService serviceImplementation="com.starnotesxj.sageide.run.SageRunSettings"/>
    <applicationConfigurable parentId="tools"
                             id="com.starnotesxj.sageide.run.SageRunSettingsConfigurable"
                             displayName="SageMath"
                             instance="com.starnotesxj.sageide.run.SageRunSettingsConfigurable"/>

    <!-- Common Sage constructs as live templates (polynomial ring, number field, ...). -->
    <defaultLiveTemplates file="liveTemplates/Sage.xml"/>

    <!-- Sage postfix templates: .ZZ/.QQ/.RR/.CC/.SR/.Integer/.N/.factor/.show/
         .vector/.matrix wrap the expression into the corresponding sage.all call.
         The provider re-exports Python's built-in postfix set too, because the
         LanguageExtensionPoint resolves one provider per language and would
         otherwise shadow Python's templates for the Sage dialect. -->
    <codeInsight.template.postfixTemplateProvider language="Sage"
                                                  implementationClass="com.starnotesxj.sageide.sugar.SagePostfixTemplateProvider"/>
  </extensions>

  <extensions defaultExtensionNs="Pythonid">
    <!-- Types the factory target (F) and the generator targets (a/x) of
         F.<a> = Constructor(...) statements.  Return types for sage stub methods
         are NOT patched here since v1.3.0 — the stubgen curated table annotates
         them directly, keeping type knowledge in the stub data layer.
         order="first": the type-provider EP loops (getReferenceType / getReturnType /
         getCallType) stop at the FIRST provider returning a non-null Ref — even when
         the Ref's content is null — so a later-registered provider can be shadowed by
         an earlier one.  This provider answers only for sugar targets in .sage files
         (null everywhere else), so being consulted first never disturbs the other
         providers while making our results immune to their Ref-shadows. -->
    <typeProvider implementation="com.starnotesxj.sageide.type.SageTypeProvider" order="first"/>
    <!-- The implicit sage.all namespace (.sage files get it injected at runtime)
         plus generator references inside sugar statements: consulted by PyReferenceImpl
         whenever ordinary Python resolution fails.  (Replaces the PsiReferenceContributor
         of <=1.1.x, which the inspection and type inference never consulted.) -->
    <pyReferenceResolveProvider implementation="com.starnotesxj.sageide.sugar.SageReferenceResolveProvider"/>
  </extensions>
</idea-plugin>








